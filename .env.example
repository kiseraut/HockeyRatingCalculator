# Set true after configuring a GitHub token in secrets/github_token.
PUBLISH=false
UPDATE_INTERVAL_HOURS=24

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-address@gmail.com
SMTP_FROM=your-address@gmail.com
ALERT_TO=your-address@gmail.com
# Store the Gmail app password in secrets/smtp_password.
